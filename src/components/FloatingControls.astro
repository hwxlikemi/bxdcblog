<div class="floating-controls">
<div style="position:relative;">
<div class="liquid-card music-popover" id="musicPopover">
<div class="music-popover-header">
<img alt="Cover" class="music-popover-cover" id="musicCover" onerror="this.src='https://images.unsplash.com/photo-1514525253161-7a46d19cd819?auto=format&amp;fit=crop&amp;w=100&amp;q=80'" src="1000067252_2.jpg"/>
<div class="music-popover-details">
<div class="music-popover-title" id="popTitle">
                        爱情信息
                    </div>
<div class="music-popover-artist" id="popArtist">
                        郭静
                    </div>
</div>
</div>
<div class="music-controls-btns">
<button class="music-ctrl-btn" type="button">
<i class="fa-solid fa-arrows-rotate"></i>
</button>
<button class="music-ctrl-btn" id="popPrevBtn" type="button">
<i class="fa-solid fa-backward-step"></i>
</button>
<button class="music-ctrl-btn play-main" id="popPlayBtn" type="button">
<i class="fa-solid fa-play" id="popPlayIcon"></i>
</button>
<button class="music-ctrl-btn" id="popNextBtn" type="button">
<i class="fa-solid fa-forward-step"></i>
</button>
<button class="music-ctrl-btn" id="popListBtn" type="button">
<i class="fa-solid fa-list-ul"></i>
</button>
</div>
</div>
<button class="float-btn" id="musicToggleBtn" type="button">
<i class="fa-solid fa-music"></i>
</button>
</div>
<button class="float-btn" id="scrollTopBtn" type="button">
<i class="fa-solid fa-chevron-up"></i>
</button>
</div>
