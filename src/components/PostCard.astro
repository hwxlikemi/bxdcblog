---
import { render, type CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { Content } = await render(post);
const tags = post.data.tags || [];
---

<article
  class="post-card"
  data-post-id={post.slug}
  data-title={post.data.title}
  data-date={post.data.date}
  data-category={post.data.category}
  data-excerpt={post.data.excerpt || ""}
  tabindex="0"
  role="button"
  aria-label={`打开文章：${post.data.title}`}
>
  <!-- 渲染后的文章 HTML 存储在 template 中，打开文章时读取 -->
  <template data-post-html>
    <Content />
  </template>

  <!-- 标签区：自动从 frontmatter 读取 -->
  {tags.length > 0 && (
    <div class="post-tags">
      {tags.map((tag) => (
        <span class="post-tag" data-tag={tag}>{tag}</span>
      ))}
    </div>
  )}

  <div class="post-title">{post.data.title}</div>
  <div class="post-meta">
    <span>
      <i class="fa-regular fa-calendar"></i>
      {post.data.date}
    </span>
    <span class="post-category-link" data-category={post.data.category}>
      <i class="fa-regular fa-folder"></i>
      {post.data.category}
    </span>
  </div>
  <p class="post-excerpt">{post.data.excerpt}</p>
  <div class="post-hint">
    <i class="fa-solid fa-arrow-right"></i>
    点击打开文章
  </div>
</article>
