<div id="commentPageOverlay">

    <div 
        class="comment-page-curtain" 
        id="commentCurtain"
    >

        <div class="comment-page-container">


            <!-- 评论头部 -->

            <div class="comment-header">


                <div class="comment-header-left">


                    <button
                        class="glass-circle-btn"
                        id="commentPageBackBtn"
                        type="button"
                        style="
                            width:44px;
                            height:44px;
                            font-size:1rem;
                        "
                    >

                        <i class="fa-solid fa-chevron-left"></i>

                    </button>



                    <div>

                        <div class="comment-header-title">

                            全部评论
                            (
                            <span id="commentCount">
                                0
                            </span>
                            )

                        </div>


                        <div class="comment-header-subtitle">

                            分享你的想法，与其他读者交流

                        </div>


                    </div>


                </div>



                <a
                    class="glass-circle-btn"
                    href="/admin"
                    target="_blank"
                    rel="noopener noreferrer"
                    title="评论管理"
                    style="
                        width:44px;
                        height:44px;
                        font-size:1rem;
                        text-decoration:none;
                        display:flex;
                        align-items:center;
                        justify-content:center;
                    "
                >

                    <i class="fa-solid fa-gear"></i>

                </a>


            </div>





            <!-- 评论编辑区域 -->


            <div class="comment-editor-area">


                <div class="comment-user-fields">


                    <label class="comment-small-field">


                        <i class="fa-regular fa-user"></i>


                        <input
                            id="commentNameField"
                            maxlength="30"
                            placeholder="昵称"
                            type="text"
                        />


                    </label>





                    <label class="comment-small-field">


                        <i class="fa-regular fa-envelope"></i>


                        <input
                            id="commentEmailField"
                            maxlength="80"
                            placeholder="邮箱"
                            type="text"
                        />


                    </label>



                </div>






                <div class="comment-composer">



                    <textarea
                        class="comment-textarea"
                        id="commentInputField"
                        maxlength="1000"
                        placeholder="善语结善缘，恶语伤人心..."
                    ></textarea>






                    <div
                        class="comment-attachment-preview"
                        id="commentAttachmentPreview"
                    >


                        <img
                            alt="图片预览"
                            id="attachmentPreviewImage"
                            src=""
                        />



                        <span id="attachmentFileName">

                            已选择图片

                        </span>





                        <div
                            class="remove-attachment"
                            id="removeAttachmentBtn"
                        >

                            <i class="fa-solid fa-xmark"></i>


                        </div>


                    </div>







                    <div class="comment-composer-toolbar">



                        <div class="composer-left-tools">



                            <button
                                class="composer-tool-btn"
                                id="uploadImgTrigger"
                                title="上传图片"
                                type="button"
                            >

                                <i class="fa-solid fa-plus"></i>


                            </button>



                        </div>







                        <button
                            class="composer-send-btn"
                            id="sendCommentBtn"
                            type="button"
                        >


                            <i class="fa-solid fa-paper-plane"></i>


                            发送


                        </button>




                    </div>




                </div>




            </div>








            <!-- 评论列表 -->


            <div
                class="comment-list-scroll"
                id="commentListScroll"
            >

            </div>





        </div>


    </div>


</div>