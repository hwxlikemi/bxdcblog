<div id="articleOverlay">
<div class="article-page" id="articlePage">
<div class="article-inner-wrapper" id="articleContent">
<h1 id="viewTitle" style="
                    font-size:2.1rem;
                    font-weight:700;
                    margin-bottom:12px;
                "></h1>
<div id="viewMeta" style="
                    font-size:0.85rem;
                    color:var(--text-secondary);
                    margin-bottom:24px;
                    padding-bottom:16px;
                    border-bottom:1px solid var(--glass-border);
                "></div>
<div id="viewBody" class="article-content" style="
                    font-size:1.05rem;
                    line-height:1.9;
                    color:var(--text-primary);
                "></div>
</div>
</div>
<!-- 返回 -->
<button class="glass-circle-btn back-circle-btn" id="backBtn" type="button">
<i class="fa-solid fa-chevron-left"></i>
</button>
<!-- 文章互动栏：右下角 -->
<div class="article-action-bar">
<!-- 评论 -->
<div class="action-btn-item">
<button class="glass-circle-btn" id="commentBtn" type="button">
<i class="fa-regular fa-comment-dots"></i>
</button>
</div>
<!-- 分享 -->
<div class="action-btn-item">
<button class="glass-circle-btn" id="shareBtn" type="button">
<i class="fa-solid fa-share-nodes"></i>
</button>
</div>
</div>
</div>
