<aside>
<div class="liquid-card">
<div class="card-title">
<i class="fa-solid fa-chart-line"></i>
                    站点统计
                </div>
<div class="stat-list">
<div class="stat-item">
<span>文章数</span>
<b>2</b>
</div>
<div class="stat-item">
<span>分类数</span>
<b>2</b>
</div>
<div class="stat-item">
<span>标签数</span>
<b>5</b>
</div>
<div class="stat-item">
<span>建站天数</span>
<b>1 天</b>
</div>
</div>
</div>
<!-- 音乐播放器 -->
<div class="liquid-card large-player-card">
<div class="card-title">
<i class="fa-solid fa-music"></i>
                    音乐播放器
                </div>
<div class="large-player-top">
<img alt="Cover" class="large-player-cover" id="largeCover" onerror="this.src='https://images.unsplash.com/photo-1514525253161-7a46d19cd819?auto=format&amp;fit=crop&amp;w=100&amp;q=80'" src="assets/images/1000067252_2.jpg"/>
<div class="large-player-info">
<div class="large-player-title" id="largeTitle">
                            爱情信息
                        </div>
<div class="large-player-artist" id="largeArtist">
                            郭静
                        </div>
<div class="large-player-time">
<span id="largeCurrTime">
                                0:00
                            </span>

                            /

                            <span id="largeDurTime">
                                0:00
                            </span>
</div>
</div>
</div>
<div class="common-progress-bar" id="commonProgressBar">
<div class="common-progress-fill" id="commonProgressFill"></div>
</div>
<div class="large-player-btns">
<button class="player-btn-item" id="modeBtn" type="button">
<i class="fa-solid fa-arrows-rotate"></i>
</button>
<button class="player-btn-item" id="prevBtn" type="button">
<i class="fa-solid fa-backward-step"></i>
</button>
<button class="player-btn-item main-play" id="mainPlayBtn" type="button">
<i class="fa-solid fa-play" id="mainPlayIcon"></i>
</button>
<button class="player-btn-item" id="nextBtn" type="button">
<i class="fa-solid fa-forward-step"></i>
</button>
<button class="player-btn-item" id="listBtn" type="button">
<i class="fa-solid fa-list-ul"></i>
</button>
</div>
</div>
<!-- 日历 -->
<div class="liquid-card">
<div class="card-title" id="calendarTitle">
<i class="fa-regular fa-calendar-days"></i>
<span>日历</span>
</div>
<div class="calendar-grid" id="calendarGrid">
<div class="cal-day-header">一</div>
<div class="cal-day-header">二</div>
<div class="cal-day-header">三</div>
<div class="cal-day-header">四</div>
<div class="cal-day-header">五</div>
<div class="cal-day-header">六</div>
<div class="cal-day-header">日</div>
</div>
</div>
<!-- 视觉调节 -->
<div class="liquid-card">
<div class="card-title">
<i class="fa-solid fa-sliders"></i>
                    玻璃视觉调整
                </div>
<div class="glass-control-group">
<div class="glass-control-item">
<div class="glass-control-label">
<span>
                                通透程度 (透明度)
                            </span>
<span id="opacityVal">
                                8%
                            </span>
</div>
<input class="glass-slider" id="opacityRange" max="0.45" min="0.02" step="0.01" type="range" value="0.08"/>
</div>
<div class="glass-control-item">
<div class="glass-control-label">
<span>
                                折射强度 (模糊度)
                            </span>
<span id="blurVal">
                                28px
                            </span>
</div>
<input class="glass-slider" id="blurRange" max="40" min="0" step="1" type="range" value="28"/>
</div>
<div class="glass-control-item">
<div class="glass-control-label">
<span>折射率</span>
<span id="refractiveVal">1.33</span>
</div>
<input class="glass-slider" id="refractiveRange" max="2.00" min="1.00" step="0.01" type="range" value="1.33"/>
</div>
</div>
</div>
</aside>
