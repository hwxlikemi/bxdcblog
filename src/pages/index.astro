---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import SidebarLeft from "../components/SidebarLeft.astro";
import PostsSection from "../components/PostsSection.astro";
import SidebarRight from "../components/SidebarRight.astro";
import Footer from "../components/Footer.astro";
import FloatingControls from "../components/FloatingControls.astro";
import ArticleView from "../components/ArticleView.astro";
import CommentPage from "../components/CommentPage.astro";
import Toast from "../components/Toast.astro";
---

<Layout>
  <div id="mainWrapper">
    <Hero />

    <div class="container">
      <SidebarLeft />
      <PostsSection />
      <SidebarRight />
    </div>

    <Footer />
  </div>

  <FloatingControls />

  <audio id="audioPlayer" preload="metadata"></audio>

  <ArticleView />
  <CommentPage />

  <input id="imgFileInput" type="file" accept="image/*" />

  <!-- 播放列表 -->
  <div id="playlistOverlay" class="playlist-overlay">
    <div class="playlist-panel">
      <div class="playlist-header">
        <span><i class="fa-solid fa-music"></i> 播放列表</span>
        <button id="playlistClose" class="playlist-close-btn" type="button">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <div class="playlist-items" id="playlistItems"></div>
    </div>
  </div>

  <Toast />
</Layout>

<script>
  import "../scripts/app.ts";
  import "../scripts/share-poster.ts";
</script>