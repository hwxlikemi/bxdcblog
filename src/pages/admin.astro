---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../config";

const envId = siteConfig.twikoo.envId.replace(/\/$/, "");
---

<Layout title="评论管理 - boxueduocai's Blog">
  <div style="max-width: 800px; margin: 0 auto; padding: 40px 20px;">
    <div style="margin-bottom: 24px;">
      <a
        href="/"
        style="
          display: inline-flex;
          align-items: center;
          gap: 8px;
          color: var(--text-primary);
          text-decoration: none;
          font-size: 0.95rem;
          padding: 10px 18px;
          background: rgba(255,255,255,0.15);
          border: 1px solid var(--glass-border);
          border-radius: 12px;
          backdrop-filter: blur(12px);
        "
      >
        <i class="fa-solid fa-chevron-left"></i>
        返回博客
      </a>
    </div>

    <h1 style="font-size: 1.6rem; margin-bottom: 8px; color: var(--text-primary);">
      评论管理
    </h1>
    <p style="color: var(--text-secondary); margin-bottom: 24px; font-size: 0.9rem;">
      快速点击下方评论区任意位置三次，即可弹出管理员登录框。
    </p>

    <!-- Twikoo 官方评论区（含管理面板入口） -->
    <div
      id="tcomment"
      data-env-id={envId}
      style="
        background: rgba(255,255,255,0.13);
        padding: 20px;
        border-radius: 18px;
        border: 1px solid var(--glass-border);
        backdrop-filter: blur(12px);
      "
    ></div>
  </div>

  <script is:inline src="https://cdn.jsdelivr.net/npm/twikoo@1.6.44/dist/twikoo.all.min.js"></script>
  <script is:inline>
    var envId = document.getElementById('tcomment').getAttribute('data-env-id');
    twikoo.init({
      envId: envId,
      el: '#tcomment',
      lang: 'zh-CN',
    });
  </script>
</Layout>
